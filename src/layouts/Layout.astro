---
import '../styles/global.css';
import { siteConfig, getPersonSchema, getWebSiteSchema } from '../components/portfolio/data/siteConfig';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	schema?: Record<string, any> | Record<string, any>[];
}

const { 
	title = siteConfig.defaultSeo.title,
	description = siteConfig.defaultSeo.description,
	image = siteConfig.defaultSeo.ogImage,
	type = 'website',
	schema
} = Astro.props;

const canonicalUrl = `${siteConfig.siteUrl}${Astro.url.pathname}`;
const ogImageUrl = image.startsWith('http') ? image : `${siteConfig.siteUrl}${image}`;

const structuredData = [
	getPersonSchema(),
	getWebSiteSchema(),
	...(Array.isArray(schema) ? schema : schema ? [schema] : [])
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		{/* Primary SEO Meta Tags */}
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={siteConfig.author.name} />
		<meta name="keywords" content={siteConfig.defaultSeo.keywords.join(', ')} />
		<meta name="robots" content="index, follow" />
		
		{/* Canonical & AI Discovery */}
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="text/plain" href={`${siteConfig.siteUrl}/llms.txt`} title="LLM Context" />

		{/* OpenGraph Social Tags */}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteConfig.siteName} />
		<meta property="og:locale" content={siteConfig.defaultSeo.locale} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		
		{/* Twitter Social Tags */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		{/* Theme controls & mobile browser chrome */}
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#09090B" media="(prefers-color-scheme: dark)" />

		{/* Fonts with Preconnect */}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@100;300;400&display=swap" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

		{/* JSON-LD Structured Data */}
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<script is:inline>
			// Inline blocking script to prevent theme flash before React hydration
			(function() {
				const theme = localStorage.getItem('portfolio-theme') || 'light';
				document.documentElement.classList.toggle('dark', theme === 'dark');
			})();
		</script>
	</head>
	<body class="bg-bg-primary text-text-primary antialiased font-sans transition-colors duration-300">
		<slot />
	</body>
</html>
