---
import { content } from '../../components/portfolio/data/content';
import Layout from '../../layouts/Layout.astro';
import type { Project } from '../../components/portfolio/data/content';

export function getStaticPaths() {
  // We use Spanish (es) to generate the paths, assuming IDs are the same
  const projects = content.es.works.projects;
  return projects.map((p) => {
    return {
      params: { id: p.id },
      props: { project: p },
    };
  });
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Default image logic
const heroImage = project.image || project.platforms?.[0]?.image || '/images/placeholder.jpg';
const galleryImages = project.images || project.platforms?.[0]?.images || [];

// Tech icon mapping
const iconMap: Record<string, string> = {
  'astro': 'astro',
  'next.js': 'nextdotjs',
  'react': 'react',
  'angular': 'angular',
  'vite': 'vite',
  'tailwind css': 'tailwindcss',
  'sapui5': 'sap',
  'openui5': 'sap',
  'asp.net': 'dotnet',
  'c#': 'dotnet',
  'python': 'python',
  'node.js': 'nodedotjs',
  'fastapi': 'fastapi',
  'odata / sap b1': 'sap',
  'flutter': 'flutter',
  'kotlin': 'kotlin',
  'jetpack compose': 'jetpackcompose',
  'android': 'android',
  'rive': 'rive',
  'room sqlite': 'sqlite',
  'room': 'sqlite',
  'koin': 'koin',
  'postgresql': 'postgresql',
  'sql server': 'microsoftsqlserver',
  'sqlite': 'sqlite',
  'docker': 'docker',
  'git': 'git',
  'supabase': 'supabase',
  'firebase': 'firebase',
  'typescript': 'typescript',
  'javascript': 'javascript',
  'dart': 'dart',
};

const getIcon = (tech: string) => {
  const key = tech.toLowerCase();
  const slug = iconMap[key];
  if (!slug) return null;
  return `https://cdn.simpleicons.org/${slug}/currentColor`;
};
---

<Layout title={`${project.title} - Antoni Escalante // Portfolio`}>
  <div class="bg-bg-primary text-text-primary antialiased min-h-screen flex flex-col relative transition-colors duration-300">
    
    {/* ─── DESKTOP TOP BAR (lg:flex) ─── */}
    <header class="hidden lg:flex w-full border-b border-border-custom/30 bg-bg-primary/80 backdrop-blur-xl sticky top-0 z-40">
      <div class="max-w-6xl w-full mx-auto px-8 h-18 flex items-center justify-between">
        <a 
          href="/#works" 
          class="inline-flex items-center gap-2.5 font-mono text-xs tracking-wider uppercase text-text-secondary hover:text-accent font-semibold transition-colors group"
        >
          <span class="w-8 h-8 rounded-full border border-border-custom/50 flex items-center justify-center group-hover:border-accent group-hover:bg-accent/10 transition-all">
            <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-0.5 transition-transform">arrow_back</span>
          </span>
          Volver a Proyectos
        </a>

        <div class="flex items-center gap-3">
          <span class="font-mono text-[11px] text-text-secondary tracking-widest uppercase">
            PROYECTO // {project.id}
          </span>
          <button 
            id="share-btn-desktop" 
            class="w-9 h-9 rounded-full border border-border-custom/50 hover:border-accent hover:bg-accent/10 flex items-center justify-center text-text-secondary hover:text-accent transition-all cursor-pointer"
            title="Compartir proyecto"
            aria-label="Compartir proyecto"
          >
            <span class="material-symbols-outlined text-[18px]">share</span>
          </button>
        </div>
      </div>
    </header>

    {/* ─── MOBILE TOP BAR (Floating App Header on Mobile) ─── */}
    <div class="lg:hidden absolute top-0 left-0 w-full flex items-center justify-between px-4 h-16 pt-[env(safe-area-inset-top)] z-30 pointer-events-none">
      <a 
        href="/#works" 
        class="w-10 h-10 rounded-full bg-black/40 hover:bg-black/60 backdrop-blur-md flex items-center justify-center text-white active:scale-95 duration-100 transition-transform pointer-events-auto shadow-lg"
        aria-label="Volver"
      >
        <span class="material-symbols-outlined text-[22px]">arrow_back</span>
      </a>
      <button 
        id="share-btn-mobile" 
        class="w-10 h-10 rounded-full bg-black/40 hover:bg-black/60 backdrop-blur-md flex items-center justify-center text-white active:scale-95 duration-100 transition-transform pointer-events-auto shadow-lg cursor-pointer"
        aria-label="Compartir"
      >
        <span class="material-symbols-outlined text-[20px]">share</span>
      </button>
    </div>

    {/* ─── HERO BANNER ─── */}
    <div class="relative w-full lg:max-w-6xl lg:mx-auto lg:px-8 lg:pt-8 shrink-0">
      <div class="relative w-full h-[38vh] lg:h-[420px] lg:rounded-[28px] overflow-hidden border-b lg:border border-border-custom/30 shadow-2xl bg-bg-secondary">
        <div 
          class="absolute inset-0 bg-cover bg-center w-full h-full transform transition-transform duration-700 hover:scale-[1.02]" 
          style={`background-image: url('${heroImage}')`}
        ></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/20 lg:from-black/70 lg:to-transparent"></div>
        
        {/* Subtle badge on bottom of desktop hero */}
        <div class="hidden lg:flex absolute bottom-6 left-8 items-center gap-3">
          <span class="glass-panel px-4 py-1.5 rounded-full font-mono text-[11px] font-bold tracking-widest text-white uppercase backdrop-blur-md border border-white/20">
            {project.role || 'Software Engineering'}
          </span>
          {project.deployment && (
            <span class="glass-panel px-4 py-1.5 rounded-full font-mono text-[11px] font-medium tracking-wide text-white/90 backdrop-blur-md border border-white/10">
              {project.deployment}
            </span>
          )}
        </div>
      </div>
    </div>

    {/* ─── MAIN CONTENT AREA ─── */}
    <main class="w-full flex-1 -mt-6 lg:mt-0 rounded-t-[32px] lg:rounded-none bg-bg-primary relative z-10 px-6 lg:px-8 pt-8 lg:pt-10 pb-32 lg:pb-24">
      <div class="max-w-6xl mx-auto">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
          
          {/* ── LEFT COLUMN (Main Case Study Content) ── */}
          <div class="lg:col-span-8 flex flex-col gap-8">
            
            {/* Title & Role */}
            <div>
              <div class="flex items-center gap-2 mb-2 lg:hidden">
                <span class="font-mono text-[10px] tracking-widest text-accent font-bold uppercase">
                  {project.role || 'Project Details'}
                </span>
                {project.deployment && (
                  <span class="text-text-secondary text-[11px]">· {project.deployment}</span>
                )}
              </div>
              <h1 class="font-heading font-black text-3xl sm:text-4xl lg:text-5xl text-text-primary tracking-tight">
                {project.title}
              </h1>
            </div>

            {/* Overview / Description */}
            <div class="flex flex-col gap-3">
              <h2 class="font-heading font-bold text-lg lg:text-xl text-text-primary uppercase tracking-wide flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-accent"></span>
                Descripción general
              </h2>
              <p class="font-sans text-base lg:text-lg text-text-secondary leading-relaxed font-normal whitespace-pre-line">
                {project.desc}
              </p>
            </div>

            {/* Challenges / Engineering Solutions */}
            {project.challenges && (
              <div class="p-6 lg:p-8 rounded-2xl bg-bg-secondary/40 border border-border-custom/50 shadow-sm flex flex-col gap-3">
                <h2 class="font-heading font-bold text-lg lg:text-xl text-text-primary uppercase tracking-wide flex items-center gap-2">
                  <span class="material-symbols-outlined text-accent text-[22px]">psychology</span>
                  Retos y Soluciones de Ingeniería
                </h2>
                <p class="font-sans text-sm lg:text-base text-text-secondary leading-relaxed whitespace-pre-line">
                  {project.challenges}
                </p>
              </div>
            )}

            {/* Mobile-only Tech Stack */}
            <div class="lg:hidden flex flex-col gap-3">
              <h2 class="font-heading font-bold text-base text-text-primary uppercase tracking-wide">
                Tecnologías
              </h2>
              <div class="flex flex-wrap gap-2">
                {project.stack.map((tech) => {
                  const iconUrl = getIcon(tech);
                  return (
                    <span class="px-3 py-1.5 rounded-lg bg-bg-secondary border border-border-custom/40 text-text-primary font-mono text-xs font-medium flex items-center gap-2">
                      {iconUrl && <img src={iconUrl} alt={tech} class="w-3.5 h-3.5 object-contain" />}
                      {tech}
                    </span>
                  );
                })}
              </div>
            </div>

            {/* ── SCREENSHOT GALLERY ── */}
            {galleryImages.length > 0 && (
              <div class="flex flex-col gap-4 mt-2">
                <div class="flex items-center justify-between">
                  <h2 class="font-heading font-bold text-lg lg:text-xl text-text-primary uppercase tracking-wide flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-accent"></span>
                    Capturas de Pantalla
                  </h2>
                  <span class="font-mono text-[11px] text-text-secondary tracking-wider">
                    {galleryImages.length} vistas
                  </span>
                </div>

                {/* Horizontal swipeable track on mobile / Responsive 3-col grid on desktop for optimal readability */}
                <div class="flex lg:grid lg:grid-cols-3 gap-5 overflow-x-auto lg:overflow-visible pb-4 lg:pb-0 snap-x snap-mandatory hide-scrollbar -mx-6 px-6 lg:mx-0 lg:px-0">
                  {galleryImages.map((imgSrc, idx) => (
                    <div class="snap-start shrink-0 w-[72vw] sm:w-[260px] lg:w-auto rounded-2xl overflow-hidden border border-border-custom/50 bg-bg-secondary/40 shadow-md hover:shadow-xl hover:border-accent/50 transition-all duration-300 group cursor-pointer relative">
                      <img 
                        src={imgSrc} 
                        alt={`${project.title} screenshot ${idx + 1}`} 
                        class="w-full h-auto object-cover group-hover:scale-[1.03] transition-transform duration-500"
                        loading="lazy"
                      />
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>

          {/* ── RIGHT COLUMN (Desktop Sticky Sidebar) ── */}
          <aside class="hidden lg:block lg:col-span-4">
            <div class="sticky top-28 flex flex-col gap-6 p-6 rounded-2xl bg-bg-secondary/30 border border-border-custom/50 shadow-sm glass-panel">
              
              <h3 class="font-heading font-extrabold text-base uppercase tracking-tight text-text-primary pb-3 border-b border-border-custom/30">
                Ficha Técnica
              </h3>

              {/* Action Buttons in Sidebar */}
              <div class="flex flex-col gap-3">
                {project.links.length > 0 && (
                  <a 
                    href={project.links[0]?.url} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-full py-3.5 px-6 rounded-xl bg-accent hover:bg-accent/90 text-white font-sans text-sm font-bold flex items-center justify-center gap-2.5 shadow-md shadow-accent/20 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer"
                  >
                    <span class="material-symbols-outlined text-[20px]">open_in_new</span>
                    {project.links[0]?.label || 'Ver Proyecto'}
                  </a>
                )}

                {project.links.length > 1 && (
                  <a 
                    href={project.links[1]?.url} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-full py-3 px-6 rounded-xl border border-border-custom/60 hover:border-accent hover:bg-accent/5 text-text-primary font-sans text-sm font-semibold flex items-center justify-center gap-2.5 transition-all cursor-pointer"
                  >
                    <span class="material-symbols-outlined text-[20px]">code</span>
                    {project.links[1]?.label || 'Código Fuente'}
                  </a>
                )}
              </div>

              {/* Metadata Details */}
              <div class="flex flex-col gap-3 text-xs pt-2 border-t border-border-custom/30">
                <div class="flex justify-between items-center py-1">
                  <span class="font-mono text-text-secondary uppercase">Rol:</span>
                  <span class="font-sans font-semibold text-text-primary text-right">{project.role || 'Desarrollador'}</span>
                </div>
                {project.deployment && (
                  <div class="flex justify-between items-center py-1">
                    <span class="font-mono text-text-secondary uppercase">Despliegue:</span>
                    <span class="font-sans font-semibold text-text-primary text-right">{project.deployment}</span>
                  </div>
                )}
              </div>

              {/* Tech Stack List */}
              <div class="flex flex-col gap-3 pt-3 border-t border-border-custom/30">
                <span class="font-mono text-[11px] text-text-secondary uppercase tracking-widest font-semibold">
                  Tecnologías utilizadas
                </span>
                <div class="flex flex-wrap gap-2">
                  {project.stack.map((tech) => {
                    const iconUrl = getIcon(tech);
                    return (
                      <span class="px-3 py-1.5 rounded-lg bg-bg-primary border border-border-custom/50 text-text-primary font-mono text-[11px] font-medium flex items-center gap-2 shadow-2xs">
                        {iconUrl && <img src={iconUrl} alt={tech} class="w-3.5 h-3.5 object-contain" />}
                        {tech}
                      </span>
                    );
                  })}
                </div>
              </div>

            </div>
          </aside>

        </div>

      </div>
    </main>

    {/* ─── MOBILE FIXED BOTTOM ACTION BAR (Hidden on Desktop) ─── */}
    <div class="lg:hidden fixed bottom-0 left-0 w-full p-4 bg-bg-primary/95 backdrop-blur-xl border-t border-border-custom/40 flex gap-3 shadow-lg z-50 pb-[calc(1rem+env(safe-area-inset-bottom))]">
      {project.links.length > 1 && (
        <a 
          href={project.links[1]?.url} 
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 py-3 px-4 rounded-xl border border-border-custom/70 text-text-primary font-sans text-sm font-semibold flex items-center justify-center gap-2 active:bg-bg-secondary transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">code</span>
          Código
        </a>
      )}
      
      {project.links.length > 0 && (
        <a 
          href={project.links[0]?.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 py-3 px-4 rounded-xl bg-accent text-white font-sans text-sm font-bold flex items-center justify-center gap-2 shadow-md shadow-accent/25 active:scale-95 transition-transform"
        >
          <span class="material-symbols-outlined text-[18px]">open_in_new</span>
          {project.links[0]?.label || 'Ver Proyecto'}
        </a>
      )}
    </div>

    {/* ─── SHARE BUTTON CLIENT LOGIC ─── */}
    <script is:inline>
      const setupShare = (btnId) => {
        const btn = document.getElementById(btnId);
        if (!btn) return;
        btn.addEventListener('click', async () => {
          if (navigator.share) {
            try {
              await navigator.share({
                title: document.title,
                url: window.location.href,
              });
            } catch (e) {}
          } else {
            await navigator.clipboard.writeText(window.location.href);
            alert('¡Enlace copiado al portapapeles!');
          }
        });
      };
      setupShare('share-btn-desktop');
      setupShare('share-btn-mobile');
    </script>

  </div>
</Layout>
