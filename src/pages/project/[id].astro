---
import { content } from '../../components/portfolio/data/content';
import Layout from '../../layouts/Layout.astro';
import type { Project } from '../../components/portfolio/data/content';

export function getStaticPaths() {
  // We use Spanish (es) to generate the paths, assuming IDs are the same
  const projects = content.es.works.projects;
  return projects.map((p) => {
    return {
      params: { id: p.id },
      props: { project: p },
    };
  });
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Default image logic
const heroImage = project.image || project.platforms?.[0]?.image || '/images/placeholder.jpg';
---

<Layout title={`${project.title} - Portfolio`}>
  <div class="bg-bg-primary text-text-primary antialiased h-screen flex flex-col relative overflow-hidden">
    
    {/* Immersive Header Area */}
    <div class="relative w-full h-[40vh] shrink-0">
      <div 
        class="absolute inset-0 bg-cover bg-center w-full h-full" 
        style={`background-image: url('${heroImage}')`}
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/20 to-bg-primary"></div>
      
      {/* Top App Bar (Back Navigation) */}
      <div class="absolute top-0 left-0 w-full flex items-center justify-between px-4 h-16 pt-[env(safe-area-inset-top)]">
        <a href="/#works" class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white active:scale-95 duration-100 transition-transform">
          <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <button class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white active:scale-95 duration-100 transition-transform">
          <span class="material-symbols-outlined">share</span>
        </button>
      </div>
    </div>
    
    {/* Scrollable Content Area */}
    <div class="flex-1 overflow-y-auto -mt-6 rounded-t-3xl bg-bg-primary relative z-10 px-6 pt-8 pb-32">
      
      {/* Title and Metadata */}
      <div class="mb-8">
        <h1 class="font-heading font-black text-3xl text-text-primary mb-1">
          {project.title}
        </h1>
        <p class="font-sans text-sm font-semibold text-accent uppercase tracking-widest">
          {project.role || 'Project Details'}
        </p>
      </div>
      
      {/* Technologies Chips */}
      <div class="mb-8">
        <h2 class="font-heading font-bold text-xl text-text-primary mb-3">Tecnologías utilizadas</h2>
        <div class="flex flex-wrap gap-2">
          {project.stack.map(tech => (
            <div class="px-4 py-2 rounded-lg bg-accent/10 text-accent font-sans text-xs font-semibold border border-accent/20">
              {tech}
            </div>
          ))}
        </div>
      </div>
      
      {/* Full Description */}
      <div class="mb-8">
        <h2 class="font-heading font-bold text-xl text-text-primary mb-3">Descripción</h2>
        <p class="font-sans text-base text-text-secondary whitespace-pre-line leading-relaxed">
          {project.desc}
        </p>
      </div>

      {project.challenges && (
        <div class="mb-8">
          <h2 class="font-heading font-bold text-xl text-text-primary mb-3">Desafíos</h2>
          <p class="font-sans text-base text-text-secondary whitespace-pre-line leading-relaxed">
            {project.challenges}
          </p>
        </div>
      )}
      
    </div>
    
    {/* Fixed Bottom Actions */}
    <div class="absolute bottom-0 left-0 w-full p-4 bg-bg-primary/90 backdrop-blur-xl border-t border-border-custom/30 flex gap-4 shadow-sm z-50 pb-[env(safe-area-inset-bottom)]">
      {project.links.length > 1 ? (
        <a 
          href={project.links[1]?.url} 
          target="_blank"
          class="flex-1 py-3.5 px-4 rounded-full border border-accent text-accent font-sans text-sm font-bold flex items-center justify-center gap-2 active:bg-accent/10 transition-colors"
        >
          <span class="material-symbols-outlined text-[20px]">code</span>
          Código
        </a>
      ) : null}
      
      {project.links.length > 0 ? (
        <a 
          href={project.links[0]?.url}
          target="_blank"
          class="flex-1 py-3.5 px-4 rounded-full bg-accent text-white font-sans text-sm font-bold flex items-center justify-center gap-2 shadow-[0_4px_12px_rgba(0,0,0,0.15)] active:scale-95 transition-transform"
        >
          <span class="material-symbols-outlined text-[20px]">open_in_new</span>
          Ver Proyecto
        </a>
      ) : null}
    </div>
    
  </div>
</Layout>
